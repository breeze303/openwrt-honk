{
	"luci-app-honk": {
		"description": "Grant access for luci-app-honk",
		"read": {
			"file": [
				"/etc/honk/config.dae",
				"/etc/honk/config.dae.default",
				"/etc/honk/config.dae.last-good",
				"/etc/config/honk",
				"/run/honk/**",
				"/tmp/honk/honk.log",
				"/usr/share/v2ray/**"
			],
			"ubus": {
				"luci.honk": [ "state", "advanced", "default_config", "diagnostics", "logs", "network_interfaces", "runtime_dashboard" ],
				"service": [ "list" ],
				"system": [ "board", "info" ],
				"network.interface": [ "dump" ],
				"network.device": [ "status" ]
			}
		},
		"write": {
			"file": [
			"/etc/config/honk",
			"/etc/honk/config.dae",
			"/etc/honk/config.dae.last-good",
			"/tmp/honk/honk.log",
				"/run/honk/luci-*.json",
				"/run/honk/luci-*.dae",
				"/run/honk/luci-*.lock"
			],
			"ubus": {
				"luci.honk": [ "preview", "apply", "service", "sources", "validate_advanced", "apply_advanced", "refresh_subscription", "subscription_cache", "delete_subscription_cache", "delay", "connectivity", "clear_logs", "toggle_clash_api", "reset_config", "apply_interfaces", "runtime_prepare" ],
				"service": [ "list" ]
			}
		}
	}
}
