{
	"luci-app-honk": {
		"description": "Grant access for luci-app-honk",
		"read": {
			"file": [
				"/etc/honk/config.dae",
				"/etc/honk/config.dae.default",
				"/etc/honk/config.dae.last-good",
				"/etc/config/honk",
				"/run/honk/**",
				"/tmp/honk/honk.log",
				"/usr/share/honk/**"
			],
			"ubus": {
				"service": [ "list" ],
				"system": [ "board", "info" ],
				"network.interface": [ "dump" ],
				"network.device": [ "status" ]
			}
		},
		"write": {
			"file": [
			"/etc/config/honk",
			"/etc/honk/config.dae",
			"/etc/honk/config.dae.last-good",
			"/tmp/honk/honk.log",
			"/usr/lib/honk/**",
				"/run/honk/luci-*.json",
				"/run/honk/luci-*.lock"
			],
			"ubus": { "service": [ "list" ] }
		}
	}
}
