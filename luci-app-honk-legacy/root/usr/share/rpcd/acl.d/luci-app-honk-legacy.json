{
	"luci-app-honk-legacy": {
		"description": "Grant access for luci-app-honk-legacy",
		"read": {
			"file": [
				"/etc/honk/config.dae",
				"/etc/config/honk",
				"/var/log/messages"
			],
			"ubus": {
				"system": [ "board", "info" ],
				"service": [ "list" ],
				"network.interface": [ "dump" ],
				"network.device": [ "status" ]
			}
		},
		"write": {
			"file": [
				"/etc/honk/config.dae",
				"/etc/config/honk",
				"/run/honk/quick/**",
				"/var/lib/honk/quick-transaction.json"
			],
			"ubus": {
				"service": [ "list" ]
			}
		}
	},
	"luci-app-honk-legacy.quick-setup": {
		"description": "Grant access for Honk Quick Setup",
		"read": {
			"ubus": {
				"network.interface": [ "dump" ],
				"network.device": [ "status" ]
			},
			"file": [ "/etc/honk/config.dae", "/run/honk/**", "/var/lib/honk/quick-transaction.json" ]
		},
		"write": {
			"file": [ "/run/honk/quick/**", "/var/lib/honk/quick-transaction.json" ]
		}
	}
}
