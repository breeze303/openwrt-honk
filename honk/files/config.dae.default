global {
	wan_interface: auto
	lan_interface: auto
	log_level: info
	dial_mode: domain
	allow_insecure: false
	auto_config_kernel_parameter: true
	store_subscribe: true
	tcp_check_url: 'http://connectivitycheck.platform.hicloud.com/generate_204'
	tcp_check_http_method: HEAD
	udp_check_dns: 'dns.google.com:53,8.8.8.8'
	check_interval: 30s
	check_tolerance: 50ms
}

dns {
	bind: 'tcp+udp://127.0.0.1:1053'
	upstream {
		alidns: 'udp://223.5.5.5:53'
		googledns: 'tcp+udp://8.8.8.8:53'
	}
	routing {
		request {
			qname(geosite: cn) -> alidns
			fallback: googledns
		}
		response {
			fallback: accept
		}
	}
}

routing {
	pname(NetworkManager, systemd-resolved, dnsmasq) -> direct(must)
	dip(geoip: private) -> direct
	fallback: direct
}

experimental {
	clash_api {
		external_controller: '0.0.0.0:9090'
		external_ui: '/www/luci-static/resources/honk/app'
		secret: ''
		default_mode: 'Rule'
	}

	cache_file {
		enabled: true
		path: '/etc/honk/cache.db'
		cache_id: 'openwrt'
		store_fakeip: false
		store_dns: false
	}
}
