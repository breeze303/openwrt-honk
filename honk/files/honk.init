#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

NAME=honk
PROG=/usr/bin/honk-core
CONFIG=/etc/honk/config.dae
DEFAULT_CONFIG=/etc/honk/config.dae.default
PIN_ROOT=/sys/fs/bpf/honk
LAUNCHER=/usr/libexec/honk/honk-launcher
LOG_DIR=/tmp/honk
LOG_FILE=$LOG_DIR/honk.log
RUN_DIR=/run/honk
GEO_DIR=/usr/share/v2ray
DEFAULT_DATA_DIR=/var/share/honk
LEGACY_SUBSCRIPTION_DIR=/etc/honk/.sub
DEFAULT_BOOTSTRAP_RESOLVER=udp://223.5.5.5:53
DNSMASQ_HELPER=/usr/libexec/honk/dnsmasq-integration

validate_config() {
	[ -r "$CONFIG" ] || {
		logger -t honk "configuration is missing: $CONFIG"
		return 1
	}
	mkdir -p "$RUN_DIR" || return 1
	VALIDATION_ERROR="$(/usr/bin/honk-tool validate --config "$CONFIG" --json 2>&1)"
	local validation_status=$?
	printf '%s\n' "$VALIDATION_ERROR" >"$RUN_DIR/config-validation.json" || return 1
	chmod 600 "$RUN_DIR/config-validation.json"
	return "$validation_status"
}

ensure_config() {
	[ -r "$CONFIG" ] && return 0
	[ -r "$DEFAULT_CONFIG" ] || {
		logger -t honk "configuration is missing and default template is unavailable: $CONFIG"
		return 1
	}
	umask 077
	cp "$DEFAULT_CONFIG" "$CONFIG" || return 1
	chmod 600 "$CONFIG" || return 1
	logger -t honk "initialized missing configuration from $DEFAULT_CONFIG"
}

configured_data_dir() {
	awk '
		/^[[:space:]]*global[[:space:]]*\{/ {
			inside = 1
			next
		}
		inside && /^[[:space:]]*data_dir[[:space:]]*:/ {
			value = $0
			sub(/^[^:]*:[[:space:]]*/, "", value)
			sub(/[[:space:]]*#.*/, "", value)
			sub(/[[:space:]]*$/, "", value)
			if (value ~ /^\047.*\047$/ || value ~ /^".*"$/) {
				value = substr(value, 2, length(value) - 2)
			}
			print value
			exit
		}
		inside && /^[[:space:]]*\}/ { exit }
	' "$CONFIG"
}

prepare_subscription_store() {
	local data_dir subscription_dir entry destination name migrated
	data_dir="$(configured_data_dir)"
	case "$data_dir" in
		/*) ;;
		*) data_dir="$DEFAULT_DATA_DIR" ;;
	esac
	data_dir="${data_dir%/}"
	[ -n "$data_dir" ] || data_dir="$DEFAULT_DATA_DIR"
	subscription_dir="$data_dir/.sub"

	if [ -L "$data_dir" ] || { [ -e "$data_dir" ] && [ ! -d "$data_dir" ]; }; then
		logger -t honk "runtime data path is not a directory: $data_dir"
		return 1
	fi
	if [ -L "$subscription_dir" ] || { [ -e "$subscription_dir" ] && [ ! -d "$subscription_dir" ]; }; then
		logger -t honk "subscription store is not a directory: $subscription_dir"
		return 1
	fi
	mkdir -p "$subscription_dir" || return 1
	chmod 700 "$data_dir" "$subscription_dir" || return 1

	[ "$subscription_dir" = "$LEGACY_SUBSCRIPTION_DIR" ] && return 0
	[ -e "$LEGACY_SUBSCRIPTION_DIR" ] || return 0
	if [ -L "$LEGACY_SUBSCRIPTION_DIR" ] || [ ! -d "$LEGACY_SUBSCRIPTION_DIR" ]; then
		logger -t honk "legacy subscription store is not a directory: $LEGACY_SUBSCRIPTION_DIR"
		return 1
	fi

	migrated=0
	for entry in "$LEGACY_SUBSCRIPTION_DIR"/*.sub; do
		[ -e "$entry" ] || continue
		if [ -L "$entry" ] || [ ! -f "$entry" ]; then
			logger -t honk "skipping unsafe legacy subscription entry: ${entry##*/}"
			continue
		fi
		name="${entry##*/}"
		destination="$subscription_dir/$name"
		if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
			mv "$entry" "$destination" || return 1
			chmod 600 "$destination" || return 1
			migrated=$((migrated + 1))
		elif [ ! -L "$destination" ] && [ -f "$destination" ] && cmp -s "$entry" "$destination"; then
			rm -f "$entry" || return 1
		else
			logger -t honk "subscription cache migration conflict: $name"
		fi
	done
	rmdir "$LEGACY_SUBSCRIPTION_DIR" 2>/dev/null || true
	[ "$migrated" -eq 0 ] || logger -t honk "migrated $migrated subscription cache file(s) to $subscription_dir"
}

ensure_bootstrap_resolver() {
	[ -r "$CONFIG" ] || return 0
	awk '
		/^[[:space:]]*global[[:space:]]*\{/ {
			inside = 1
			next
		}
		inside && /^[[:space:]]*bootstrap_resolver[[:space:]]*:/ { found = 1 }
		inside && /^[[:space:]]*\}/ { inside = 0 }
		END { exit(found ? 0 : 1) }
	' "$CONFIG" && return 0

	local temp_file
	temp_file="$RUN_DIR/config-bootstrap.tmp.$$"
	awk -v resolver="$DEFAULT_BOOTSTRAP_RESOLVER" '
		/^[[:space:]]*global[[:space:]]*\{/ {
			inside = 1
			print
			next
		}
		inside && /^[[:space:]]*fallback_resolver[[:space:]]*:/ && !inserted {
			print "\tbootstrap_resolver: \047" resolver "\047"
			inserted = 1
		}
		inside && /^[[:space:]]*\}/ && !inserted {
			print "\tbootstrap_resolver: \047" resolver "\047"
			inserted = 1
		}
		{ print }
	' "$CONFIG" >"$temp_file" || {
		rm -f "$temp_file"
		return 1
	}
	if cmp -s "$CONFIG" "$temp_file"; then
		rm -f "$temp_file"
		return 0
	fi
	chmod 600 "$temp_file"
	mv "$temp_file" "$CONFIG" || return 1
	logger -t honk "added bootstrap resolver $DEFAULT_BOOTSTRAP_RESOLVER"
}

dns_listener_binding_present() {
	awk '
		/^[[:space:]]*dns[[:space:]]*\{/ && !inside {
			inside = 1
			depth = 1
			next
		}
		inside {
			if ($0 ~ /^[[:space:]]*bind[[:space:]]*:/) found = 1
			opened = gsub(/\{/, "{")
			closed = gsub(/\}/, "}")
			depth += opened - closed
			if (depth <= 0) inside = 0
		}
		END { exit(found ? 0 : 1) }
	' "$CONFIG"
}

ensure_dns_listener_binding() {
	[ -r "$CONFIG" ] || return 0
	dns_listener_binding_present && return 0
	local temp_file
	temp_file="$RUN_DIR/config-dns-bind.tmp.$$"
	if grep -Eq '^[[:space:]]*dns[[:space:]]*\{' "$CONFIG"; then
		awk '
			/^[[:space:]]*dns[[:space:]]*\{/ && !inserted {
				print
				print "\tbind: '\''tcp+udp://127.0.0.1:1053'\''"
				inserted = 1
				next
			}
			{ print }
		' "$CONFIG" >"$temp_file"
	else
		awk '
			{ print }
			END {
				print ""
				print "dns {"
				print "\tbind: '\''tcp+udp://127.0.0.1:1053'\''"
				print "}"
			}
		' "$CONFIG" >"$temp_file"
	fi
	chmod 600 "$temp_file"
	mv "$temp_file" "$CONFIG" || return 1
	logger -t honk "added DNS listener binding for dnsmasq forwarding"
}

migrate_managed_dns_routing() {
	[ -r "$CONFIG" ] || return 0
	grep -F '# luci-app-honk managed: v1 mode=' "$CONFIG" >/dev/null 2>&1 || return 0
	local temp_file
	temp_file="$RUN_DIR/config-dns-migrate.tmp.$$"
	awk '
		function dns_rule() { print "\tpname(NetworkManager, systemd-resolved, dnsmasq) -> direct(must)" }
		function private_rule() { print "\tdip(geoip: private) -> direct" }
		/^routing[[:space:]]*\{/ {
			inside = 1
			print
			next
		}
		inside && /^[[:space:]]*pname\(dnsmasq\)[[:space:]]*->[[:space:]]*direct\(must\)[[:space:]]*$/ {
			if (!has_dns) dns_rule()
			has_dns = 1
			next
		}
		inside && /^[[:space:]]*pname\(dnsmasq\)[[:space:]]*&&[[:space:]]*l4proto\(udp\)[[:space:]]*&&[[:space:]]*dport\(53\)[[:space:]]*->[[:space:]]*direct\(must\)[[:space:]]*$/ {
			if (!has_dns) dns_rule()
			has_dns = 1
			next
		}
		inside && /^[[:space:]]*pname\(NetworkManager,[[:space:]]*systemd-resolved,[[:space:]]*dnsmasq\)[[:space:]]*->[[:space:]]*direct\(must\)[[:space:]]*$/ {
			if (!has_dns) dns_rule()
			has_dns = 1
			next
		}
		inside && /^[[:space:]]*dip\(geoip:[[:space:]]*private[[:space:]]*\)[[:space:]]*->[[:space:]]*direct\(must\)[[:space:]]*$/ {
			if (!has_private) private_rule()
			has_private = 1
			next
		}
		inside && /^[[:space:]]*dip\(geoip:[[:space:]]*private[[:space:]]*\)[[:space:]]*&&[[:space:]]*!dport\(53\)[[:space:]]*->[[:space:]]*direct\(must\)[[:space:]]*$/ {
			if (!has_private) private_rule()
			has_private = 1
			next
		}
		inside && /^[[:space:]]*dip\(geoip:[[:space:]]*private[[:space:]]*\)[[:space:]]*->[[:space:]]*direct[[:space:]]*$/ {
			if (!has_private) private_rule()
			has_private = 1
			next
		}
		inside && /^[[:space:]]*fallback:/ {
			if (!has_dns) { dns_rule(); has_dns = 1 }
			if (!has_private) { private_rule(); has_private = 1 }
			print
			next
		}
		inside && /^[[:space:]]*\}/ {
			if (!has_dns) { dns_rule(); has_dns = 1 }
			if (!has_private) { private_rule(); has_private = 1 }
			print
			inside = 0
			next
		}
		{ print }
	' "$CONFIG" >"$temp_file" || {
		rm -f "$temp_file"
		return 1
	}
	if cmp -s "$CONFIG" "$temp_file"; then
		rm -f "$temp_file"
		return 0
	fi
	chmod 600 "$temp_file"
	mv "$temp_file" "$CONFIG" || return 1
	logger -t honk "migrated managed routing to fixed resolver and private-network rules"
}

validate_geo_assets() {
	local geosite_labels geoip_labels missing
	geosite_labels="$(printf '%s\n' "$VALIDATION_ERROR" | jq -r '[.geo.geosite[]? | tostring | split("@")[0] | select(. != "")] | unique | join(",")' 2>/dev/null || true)"
	geoip_labels="$(printf '%s\n' "$VALIDATION_ERROR" | jq -r '[.geo.geoip[]? | tostring | split("@")[0] | select(. != "")] | unique | join(",")' 2>/dev/null || true)"
	if [ -z "$geosite_labels" ] && [ -z "$geoip_labels" ]; then
		return 0
	fi
	missing=""
	if [ -n "$geosite_labels" ] && [ ! -s "$GEO_DIR/geosite.dat" ]; then
		missing="$missing geosite.dat"
	fi
	if [ -n "$geoip_labels" ] && [ ! -s "$GEO_DIR/geoip.dat" ]; then
		missing="$missing geoip.dat"
	fi
	if [ -n "$missing" ]; then
		logger -t honk "required Geo data is missing from $GEO_DIR:$missing"
		return 1
	fi
	return 0
}

start_service() {
	local respawn SUBSCRIPTION_CACHE_TTL dnsmasq_forwarding
	config_load honk
	config_get_bool respawn main respawn 1
	config_get dnsmasq_forwarding main dnsmasq_forwarding ""
	[ -n "$dnsmasq_forwarding" ] || config_get dnsmasq_forwarding main proxy_local_dns 1
	case "$dnsmasq_forwarding" in 0|1) ;; *) dnsmasq_forwarding=1 ;; esac
	config_get SUBSCRIPTION_CACHE_TTL main subscription_cache_ttl 604800
	case "$SUBSCRIPTION_CACHE_TTL" in
		''|*[!0-9]*) SUBSCRIPTION_CACHE_TTL=604800 ;;
	esac
	mkdir -p "$RUN_DIR" || return 1
	if [ -x /usr/libexec/honk/quick-transaction-worker ]; then
		HONK_QUICK_RECOVERY_FROM_INIT=1 /usr/libexec/honk/quick-transaction-worker --recover >/run/honk/quick-recovery.json 2>&1 || {
			logger -t honk "Quick Setup recovery failed"
			return 1
		}
		chmod 600 /run/honk/quick-recovery.json
	fi
	if pidof dae daed >/dev/null 2>&1; then
		logger -t honk "dae/daed is active; refusing to reuse its fixed runtime resources"
		return 1
	fi
	ensure_config || return 1
	ensure_bootstrap_resolver || {
		logger -t honk "bootstrap resolver migration failed"
		return 1
	}
	prepare_subscription_store || {
		logger -t honk "subscription store preparation failed"
		return 1
	}
	if [ "$dnsmasq_forwarding" -eq 1 ]; then
		ensure_dns_listener_binding || {
			logger -t honk "DNS listener binding migration failed"
			return 1
		}
	fi
	migrate_managed_dns_routing || {
		logger -t honk "managed DNS routing migration failed"
		return 1
	}
	# Resolve only the untouched package template. Customized configurations keep
	# their explicit interface choices across restarts and package upgrades.
	if [ -x /usr/libexec/honk/interface-discovery ] && cmp -s "$CONFIG" "$DEFAULT_CONFIG"; then
		/usr/libexec/honk/interface-discovery --apply "$CONFIG" "$DEFAULT_CONFIG" "$RUN_DIR/interface-discovery.json" >/dev/null 2>&1 || true
	fi
	validate_config || {
		logger -t honk "configuration validation failed: $VALIDATION_ERROR"
		return 1
	}
	CONFIG_SHA_BEFORE="$(sha256sum "$CONFIG" | cut -d ' ' -f 1)" || return 1
	validate_geo_assets || return 1
	[ "$CONFIG_SHA_BEFORE" = "$(sha256sum "$CONFIG" | cut -d ' ' -f 1)" ] || {
		logger -t honk "configuration changed during preflight; refusing to start"
		return 1
	}
	mkdir -p "$PIN_ROOT" || return 1
	mkdir -p "$LOG_DIR" || return 1
	touch "$LOG_FILE" || return 1
	chmod 640 "$LOG_FILE"
	if [ "$dnsmasq_forwarding" -eq 0 ] && [ -x "$DNSMASQ_HELPER" ]; then
		"$DNSMASQ_HELPER" disable || logger -t honk "failed to disable dnsmasq forwarding"
	fi

	procd_open_instance "$NAME"
	procd_set_param command "$LAUNCHER" --config "$CONFIG" --bpf-pin-root "$PIN_ROOT"
	# procd accepts one environment table per instance. Keep the variables in
	# one call so a later value does not overwrite the preceding table.
	procd_set_param env \
		"DAE_LOCATION_ASSET=$GEO_DIR" \
		"HONK_DNSMASQ_FORWARDING=$dnsmasq_forwarding" \
		"HONK_SUBSCRIPTION_CACHE_TTL=$SUBSCRIPTION_CACHE_TTL"
	[ "$respawn" -eq 1 ] && procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65536 65536"
	procd_close_instance
}

stop_service() {
	# Honk owns and cleans its TC/eBPF resources during shutdown.
	[ -x "$DNSMASQ_HELPER" ] && "$DNSMASQ_HELPER" disable || logger -t honk "failed to disable dnsmasq forwarding"
	return 0
}

reload_service() {
	local pid
	pid="$(pidof honk-core 2>/dev/null)"
	pid="${pid%% *}"
	if [ -n "$pid" ]; then
		kill -HUP "$pid" 2>/dev/null || return 1
		return 0
	fi
	return 1
}

service_triggers() {
	procd_add_reload_trigger honk
}
