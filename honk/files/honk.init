#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

NAME=honk
PROG=/usr/bin/honk-core
CONFIG=/etc/honk/config.dae
PIN_ROOT=/sys/fs/bpf/honk
LAUNCHER=/usr/libexec/honk/honk-launcher
LOG_DIR=/tmp/honk
LOG_FILE=$LOG_DIR/honk.log

validate_config() {
	[ -r "$CONFIG" ] || {
		logger -t honk "configuration is missing: $CONFIG"
		return 1
	}
	VALIDATION_ERROR="$(/usr/bin/honk-tool validate --config "$CONFIG" --json 2>&1)" || return 1
	return 0
}

start_service() {
	local respawn
	config_load honk
	config_get_bool respawn main respawn 1
	if pidof dae daed >/dev/null 2>&1; then
		logger -t honk "dae/daed is active; refusing to reuse its fixed runtime resources"
		return 1
	fi
	validate_config || {
		logger -t honk "configuration validation failed: $VALIDATION_ERROR"
		return 1
	}
	mkdir -p "$PIN_ROOT" || return 1
	mkdir -p "$LOG_DIR" || return 1
	touch "$LOG_FILE" || return 1
	chmod 640 "$LOG_FILE"

	procd_open_instance "$NAME"
	procd_set_param command "$LAUNCHER" --config "$CONFIG" --bpf-pin-root "$PIN_ROOT"
	procd_set_param env DAE_LOCATION_ASSET=/usr/share/v2ray
	[ "$respawn" -eq 1 ] && procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65536 65536"
	procd_close_instance
}

stop_service() {
	# Honk owns and cleans its TC/eBPF resources during shutdown.
	return 0
}

reload_service() {
	local pid
	pid="$(pidof honk-core 2>/dev/null)"
	pid="${pid%% *}"
	if [ -n "$pid" ]; then
		kill -HUP "$pid" 2>/dev/null || return 1
		return 0
	fi
	return 1
}

service_triggers() {
	procd_add_reload_trigger honk
}
