 pub async fn run(cli: Cli) -> anyhow::Result<()> {
+    struct OpenWrtLocalTimer;
+
+    impl tracing_subscriber::fmt::time::FormatTime for OpenWrtLocalTimer {
+        fn format_time(
+            &self,
+            writer: &mut tracing_subscriber::fmt::format::Writer<'_>,
+        ) -> std::fmt::Result {
+            write!(
+                writer,
+                "{}",
