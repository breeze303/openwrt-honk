+/// Current resident set size in bytes, matching Mihomo's `/memory` payload.
+fn process_rss_bytes() -> u64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|status| {
+            status
+                .lines()
+                .find(|line| line.starts_with("VmRSS:"))
+                .and_then(|line| line.split_whitespace().nth(1))
+                .and_then(|value| value.parse::<u64>().ok())
+        })
+        .unwrap_or(0)
+        .saturating_mul(1024)
+}
+
+fn memory_json() -> serde_json::Value {
+    serde_json::json!({"inuse": process_rss_bytes()})
+}
+
+async fn get_memory(ws: MaybeWs) -> Response {
+    let Some(ws) = ws.0 else {
+        return chunked_json_response(memory_chunk_stream());
+    };
+    ws.on_upgrade(memory_ws)
+}
+
+async fn memory_ws(mut socket: WebSocket) {
+    let mut tick = tokio::time::interval(Duration::from_secs(1));
+    tick.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    loop {
+        tick.tick().await;
+        if socket
+            .send(Message::Text(memory_json().to_string().into()))
+            .await
+            .is_err()
+        {
+            break;
+        }
+    }
+}
+
+fn memory_chunk_stream(
+) -> impl futures::Stream<Item = Result<Bytes, std::io::Error>> + Send + 'static {
+    futures::stream::unfold((), |_| async move {
+        tokio::time::sleep(Duration::from_secs(1)).await;
+        Some((Ok(Bytes::from(format!("{}\n", memory_json()))), ()))
+    })
+}
