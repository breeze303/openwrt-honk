 use std::path::PathBuf;
 use tracing::{info, warn};
 
+type LogLevelSetter = dyn Fn(&str) -> Result<(), String> + Send + Sync + 'static;
+
+/// Handle installed by `run` so a committed config reload can update the
+/// process-wide formatting filter without restarting the datapath.
+static LOG_LEVEL_SETTER: std::sync::OnceLock<std::sync::Arc<LogLevelSetter>> =
+    std::sync::OnceLock::new();
+
+fn normalized_log_level(level: &str) -> &str {
+    if level.trim().is_empty() {
+        "info"
+    } else {
+        level.trim()
+    }
+}
+
+pub(crate) fn validate_log_level(level: &str) -> Result<(), String> {
+    tracing_subscriber::EnvFilter::try_new(normalized_log_level(level))
+        .map(|_| ())
+        .map_err(|error| error.to_string())
+}
+
+pub(crate) fn reload_log_level(level: &str) -> Result<(), String> {
+    let level = normalized_log_level(level);
+    if let Some(setter) = LOG_LEVEL_SETTER.get() {
+        setter(level)
+    } else {
+        validate_log_level(level)
+    }
+}
