-/// Whether `path` is a mountpoint (appears in /proc/mounts).
+/// Whether `path`, or an existing namespace handle beneath it, is mounted.
+///
+/// `ip netns add NAME` bind-mounts `/run/netns/NAME` but does not mount the
+/// registry directory itself. Mounting a tmpfs over that directory would hide
+/// those live handles, so the daens compatibility mount must reuse the
+/// existing registry whenever it already contains a namespace mount.
+#[cfg(any(feature = "ebpf", test))]
+fn registry_mount_exists(mounts: &str, path: &str) -> bool {
+    let root = path.trim_end_matches('/');
+    let child_prefix = format!("{root}/");
+    mounts.lines().filter_map(|line| line.split_whitespace().nth(1)).any(|mount| {
+        mount == root || mount.starts_with(&child_prefix)
+    })
+}
+
+/// Whether `path`, or a child namespace handle, appears in `/proc/mounts`.
 #[cfg(feature = "ebpf")]
 fn is_mountpoint(path: &str) -> bool {
     std::fs::read_to_string("/proc/mounts")
-        .map(|m| m.lines().any(|l| l.split_whitespace().nth(1) == Some(path)))
+        .map(|mounts| registry_mount_exists(&mounts, path))
         .unwrap_or(false)
 }
+
+#[cfg(test)]
+mod netns_registry_tests {
+    use super::registry_mount_exists;
+
+    #[test]
+    fn existing_ip_netns_handle_keeps_registry_visible() {
+        let mounts = "nsfs /run/netns/hkcache-client nsfs rw 0 0\n";
+        assert!(registry_mount_exists(mounts, "/run/netns"));
+        assert!(!registry_mount_exists(mounts, "/run/other-netns"));
+    }
+}
+    }
