+async fn get_subscriptions(State(s): State<Arc<ClashState>>) -> Json<serde_json::Value> {
+    let config = s.config.read().await;
+    let subscriptions = config
+        .subscriptions
+        .iter()
+        .map(|subscription| {
+            let nodes = config
+                .nodes
+                .iter()
+                .filter(|node| node.subscription_id == Some(subscription.id))
