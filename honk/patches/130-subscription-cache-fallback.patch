+fn cached_subscription_path(sub: &Subscription) -> Option<PathBuf> {
+    let root = std::env::var_os("HONK_SUBSCRIPTION_CACHE_DIR")?;
+    let name: String = sub
+        .name
+        .chars()
+        .map(|ch| {
+            if ch.is_ascii_alphanumeric() || matches!(ch, '_' | '-' | '.') {
+                ch
+            } else {
+                '_'
+            }
+        })
+        .collect();
+    if name.is_empty() {
+        return None;
+    }
+    Some(PathBuf::from(root).join(format!("{name}.sub")))
+}
+
+fn read_cached_subscription(sub: &Subscription) -> Option<String> {
+    let path = cached_subscription_path(sub)?;
+    let content = std::fs::read_to_string(path).ok()?;
+    (!content.trim().is_empty()).then_some(content)
+}
