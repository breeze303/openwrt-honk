+/// Whether `path`, or a child namespace handle, appears in `/proc/mounts`.
 #[cfg(feature = "ebpf")]
 fn is_mountpoint(path: &str) -> bool {
+    let canonical_path = std::fs::canonicalize(path)
+        .ok()
+        .and_then(|canonical_path| canonical_path.into_os_string().into_string().ok());
