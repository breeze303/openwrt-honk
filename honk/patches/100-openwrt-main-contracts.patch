+async fn refresh_subscription(
+    State(s): State<Arc<ClashState>>,
+    Path(name): Path<String>,
+) -> Response {
+    let subscription = {
+        let config = s.config.read().await;
+        config
+            .subscriptions
+            .iter()
+            .find(|subscription| subscription.name == name)
+            .cloned()
+    };
+    let Some(subscription) = subscription else {
+        return error_response(StatusCode::NOT_FOUND, "subscription not found");
+    };
+    let command_tx = s.command_tx.clone();
+    tokio::spawn(async move {
+        let result = match crate::subscription::SubscriptionManager::new() {
+            Ok(manager) => manager.fetch(&subscription).await,
+            Err(error) => Err(error),
+        };
+        match result {
+            Ok(nodes) => {
+                let _ = command_tx
+                    .send(crate::control::ControlCommand::MergeSubscription {
+                        subscription_id: subscription.id,
+                        name: subscription.name,
+                        nodes,
+                    })
+                    .await;
+            }
+            Err(error) => {
+                let _ = command_tx
+                    .send(crate::control::ControlCommand::SubscriptionError {
+                        subscription_id: subscription.id,
+                        name: subscription.name,
+                        error: error
+                            .to_string()
+                            .replace(&subscription.url, "<subscription>"),
+                    })
+                    .await;
+            }
+        }
+    });
+    StatusCode::ACCEPTED.into_response()
+}
