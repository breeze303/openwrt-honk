diff --git a/crates/honk-tool/src/validate.rs b/crates/honk-tool/src/validate.rs
new file mode 100644
index 0000000..9f0a567
--- /dev/null
+++ b/crates/honk-tool/src/validate.rs
@@ -0,0 +1,141 @@
+use anyhow::Result;
+use clap::Args;
+use honk_config::Config;
+use honk_config::dns::{DnsCond, DnsDomainMatcher};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::fs;
+use std::path::PathBuf;
+
+fn hex_digest(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+fn diagnostic_code(message: &str) -> (&'static str, i32) {
+    let lower = message.to_ascii_lowercase();
+    if lower.contains("unsupported") || lower.contains("unsafe") {
+        ("UNSAFE", 3)
+    } else {
+        ("SYNTAX", 2)
+    }
+}
+
+fn collect_dns_geo(config: &Config, geosite: &mut Vec<String>, geoip: &mut Vec<String>) {
+    let mut collect_conditions = |conditions: &[DnsCond]| {
+        for condition in conditions {
+            match condition {
+                DnsCond::Qname { matchers, .. } => {
+                    for matcher in matchers {
+                        if let DnsDomainMatcher::Geosite(code) = matcher {
+                            geosite.push(code.clone());
+                        }
+                    }
+                }
+                DnsCond::Ip { geoip: codes, .. } => geoip.extend(codes.iter().cloned()),
+                _ => {}
+            }
+        }
+    };
+    for rule in &config.dns.routing.request.rules {
+        collect_conditions(&rule.conditions);
+    }
+    for rule in &config.dns.routing.response.rules {
+        collect_conditions(&rule.conditions);
+    }
+    for rule in &config.dns.routing.rules {
+        if let Some(code) = rule.domain.strip_prefix("geosite:") {
+            geosite.push(code.to_string());
+        }
+        if let Some(code) = rule.domain.strip_prefix("geoip:") {
+            geoip.push(code.to_string());
+        }
+    }
+    geosite.sort_unstable();
+    geosite.dedup();
+    geoip.sort_unstable();
+    geoip.dedup();
+}
+
+#[derive(Args)]
+pub struct ValidateArgs {
+    /// Configuration path. The path is fixed by the OpenWrt service wrapper.
+    #[arg(long, conflicts_with = "config_fd")]
+    pub config: Option<PathBuf>,
+    /// Read the configuration from an already-open file descriptor.
+    #[arg(long, conflicts_with = "config")]
+    pub config_fd: Option<i32>,
+    /// Logical path used in diagnostics when reading from a file descriptor.
+    #[arg(long, default_value = "<config-fd>")]
+    pub logical_path: String,
+    /// Emit a machine-readable result.
+    #[arg(long)]
+    pub json: bool,
+}
+
+pub fn run(args: ValidateArgs) -> Result<()> {
+    let path = if let Some(fd) = args.config_fd {
+        format!("/proc/self/fd/{fd}")
+    } else {
+        args.config
+            .unwrap_or_else(|| PathBuf::from("/etc/honk/config.dae"))
+            .to_string_lossy()
+            .into_owned()
+    };
+
+    let bytes = match fs::read(&path) {
+        Ok(bytes) => bytes,
+        Err(error) => {
+            if args.json {
+                println!(
+                    "{}",
+                    json!({"schemaVersion":"honk.validate.v1","ok":false,"path":args.logical_path,"configSha256":null,"parserVersion":"honk-config-v1","diagnostics":[{"code":"IO","message":error.to_string()}]})
+                );
+            }
+            std::process::exit(4);
+        }
+    };
+    let mut digest = Sha256::new();
+    digest.update(&bytes);
+    let config_sha = hex_digest(digest.finalize().as_ref());
+    let parsed = Config::from_file(&path);
+    let result = parsed
+        .as_ref()
+        .map_err(|e| e.to_string())
+        .and_then(|config| config.validate().map_err(|e| e.to_string()));
+    match result {
+        Ok(()) => {
+            if args.json {
+                let mut geosite = Vec::new();
+                let mut geoip = Vec::new();
+                if let Ok(config) = parsed {
+                    for rule in &config.routing.rules {
+                        geosite.extend(rule.condition.geosite.iter().cloned());
+                        geoip.extend(rule.condition.geo_ip.iter().cloned());
+                    }
+                    collect_dns_geo(&config, &mut geosite, &mut geoip);
+                }
+                geosite.sort_unstable();
+                geosite.dedup();
+                geoip.sort_unstable();
+                geoip.dedup();
+                println!(
+                    "{}",
+                    json!({"schemaVersion":"honk.validate.v1","ok":true,"path":args.logical_path,"configSha256":config_sha,"parserVersion":"honk-config-v1","geo":{"geosite":geosite,"geoip":geoip},"diagnostics":[]})
+                );
+            } else {
+                println!("configuration is valid: {}", path);
+            }
+            Ok(())
+        }
+        Err(error) => {
+			let (diagnostic, exit_code) = diagnostic_code(&error);
+            if args.json {
+                println!(
+                    "{}",
+                    json!({"schemaVersion":"honk.validate.v1","ok":false,"path":args.logical_path,"configSha256":config_sha,"parserVersion":"honk-config-v1","diagnostics":[{"code":diagnostic,"message":error}]})
+                );
+            }
+            std::process::exit(exit_code);
+        }
+    }
+}
