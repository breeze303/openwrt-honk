+async fn wrap_ws_with_early_data(
+    node: &Node,
+    mut stream: Box<dyn AsyncReadWrite>,
+    data: &[u8],
+) -> anyhow::Result<Box<dyn AsyncReadWrite>> {
+    use base64::Engine as _;
+    use rand::Rng;
+    use sha1::Digest;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    let path = node.ws_path.as_deref().unwrap_or("/");
+    let ws_host = node.ws_host.as_deref().unwrap_or(node.host());
+    let mut key_bytes = [0u8; 16];
+    rand::rng().fill_bytes(&mut key_bytes);
+    let key = base64::engine::general_purpose::STANDARD.encode(key_bytes);
+    let early = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(data);
+    let request = format!(
+        "GET {path} HTTP/1.1\r\nHost: {ws_host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: {early}\r\n\r\n"
+    );
+    stream.write_all(request.as_bytes()).await?;
+
+    let mut response = Vec::with_capacity(1024);
+    let mut byte = [0u8; 1];
+    while !response.ends_with(b"\r\n\r\n") {
+        stream.read_exact(&mut byte).await?;
+        response.push(byte[0]);
+        if response.len() > 32 * 1024 {
+            anyhow::bail!("WebSocket upgrade response headers too large");
+        }
+    }
+    let response_text = String::from_utf8_lossy(&response);
+    let status_ok = response_text
+        .lines()
+        .next()
+        .is_some_and(|line| line.starts_with("HTTP/1.1 101 ") || line.starts_with("HTTP/2 101 "));
+    if !status_ok {
+        anyhow::bail!("WebSocket upgrade failed: {}", response_text.lines().next().unwrap_or(""));
+    }
+    let accept = response_text.lines().skip(1).find_map(|line| {
+        line.strip_prefix("Sec-WebSocket-Accept:").map(str::trim)
+    });
+    let mut digest = sha1::Sha1::new();
+    digest.update(key.as_bytes());
+    digest.update(b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
+    let expected = base64::engine::general_purpose::STANDARD.encode(digest.finalize());
+    if accept != Some(expected.as_str()) {
+        anyhow::bail!("WebSocket upgrade failed: invalid Sec-WebSocket-Accept");
+    }
+
+    tracing::debug!(node = %node.name, bytes = data.len(), "WebSocket early data enabled");
+    let ws_stream = tokio_tungstenite::WebSocketStream::from_raw_socket(
+        stream,
+        tokio_tungstenite::tungstenite::protocol::Role::Client,
+        None,
+    )
+    .await;
+    let (client_half, server_half) = tokio::io::duplex(65536);
+    tokio::spawn(ws_bridge_relay(ws_stream, server_half));
+    Ok(Box::new(client_half))
+}
