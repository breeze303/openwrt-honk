new file mode 100644
index 0000000..afe45a1
--- /dev/null
+++ b/crates/honk-tool/src/geo.rs
@@ -0,0 +1,419 @@
+use anyhow::{Context, Result};
+use clap::{Args, Subcommand};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+const LOCK_SITE_SHA: &str = "1f3a743e8e30152a870a1674792af3976361436dcb1f510a43c499d430f6b13f";
+const LOCK_IP_SHA: &str = "b71d1999439dde2de2d2b6844a2befa50c50211ff739785c005ca7c230a17d6a";
+const LOCK_SITE_SIZE: u64 = 10_540_162;
+const LOCK_IP_SIZE: u64 = 22_765_206;
+
+fn hex_digest(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+#[derive(Args)]
+pub struct GeoCommand {
+    #[command(subcommand)]
+    pub command: GeoSubcommand,
+}
+
+#[derive(Subcommand)]
+pub enum GeoSubcommand {
+    /// Report disk and live Geo capabilities.
+    Capabilities(CapabilityArgs),
+    /// Restore only Honk's geosite symlink to the locked payload.
+    Repair(RepairArgs),
+}
+
+#[derive(Args, Clone)]
+pub struct CapabilityArgs {
+    #[arg(long)]
+    pub json: bool,
+    #[arg(long, value_delimiter = ',', default_value = "gfw,cn,private")]
+    pub labels: Vec<String>,
+    #[arg(long = "geoip-labels", value_delimiter = ',', default_value = "cn")]
+    pub geoip_labels: Vec<String>,
+}
+
+#[derive(Args)]
+pub struct RepairArgs {
+    #[arg(long)]
+    pub json: bool,
+    #[arg(long)]
+    pub confirm: bool,
+}
+
+fn asset_dir() -> PathBuf {
+    std::env::var_os("DAE_LOCATION_ASSET")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("/usr/share/honk"))
+}
+
+fn sha256(path: &Path) -> io::Result<String> {
+    let bytes = fs::read(path)?;
+    let mut digest = Sha256::new();
+    digest.update(bytes);
+    Ok(hex_digest(digest.finalize().as_ref()))
+}
+
+fn resolved(path: &Path) -> String {
+    fs::canonicalize(path)
+        .unwrap_or_else(|_| path.to_path_buf())
+        .display()
+        .to_string()
+}
+
+/// Read only the top-level code index from a V2Ray protobuf DAT. This keeps
+/// capability checks independent of the routing matcher while rejecting
+/// malformed payloads and substring false positives.
+fn has_code(path: &Path, label: &str) -> io::Result<bool> {
+    let bytes = fs::read(path)?;
+    has_code_bytes(&bytes, label)
+}
+
+fn has_code_bytes(bytes: &[u8], label: &str) -> io::Result<bool> {
+    if label.trim().is_empty() {
+        return Ok(false);
+    }
+    let mut decoder = ProtoDecoder::new(bytes);
+    while !decoder.is_empty() {
+        let (tag, wire) = decoder.read_tag()?;
+        if tag != 1 {
+            decoder.skip_field(wire)?;
+            continue;
+        }
+        let entry = decoder.read_len_delimited()?;
+        let mut entry_decoder = ProtoDecoder::new(entry);
+        while !entry_decoder.is_empty() {
+            let (entry_tag, entry_wire) = entry_decoder.read_tag()?;
+            if entry_tag == 1 {
+                let code = String::from_utf8_lossy(entry_decoder.read_len_delimited()?)
+                    .trim()
+                    .to_ascii_lowercase();
+                if code == label.trim().to_ascii_lowercase() {
+                    return Ok(true);
+                }
+            } else {
+                entry_decoder.skip_field(entry_wire)?;
+            }
+        }
+    }
+    Ok(false)
+}
+
+fn requested_labels(path: &Path, labels: &[String]) -> Vec<Value> {
+    labels
+        .iter()
+        .map(|label| {
+            let present = has_code(path, label).unwrap_or(false);
+            json!({"label": label, "present": present})
+        })
+        .collect()
+}
+
+fn status_for(
+    path: &Path,
+    expected_sha: &str,
+    expected_size: u64,
+    provider: &str,
+) -> (&'static str, String, u64, bool) {
+    let resolved_path = resolved(path);
+    let Ok(metadata) = fs::metadata(path) else {
+        return ("MISSING", resolved_path, 0, false);
+    };
+    let Ok(actual_sha) = sha256(path) else {
+        return ("MISSING", resolved_path, metadata.len(), false);
+    };
+    if resolved_path.starts_with("/usr/share/v2ray/") || resolved_path.starts_with("/etc/v2ray/") {
+        return (
+            "V2FLY_GFW_UNSUPPORTED",
+            resolved_path,
+            metadata.len(),
+            false,
+        );
+    }
+    if actual_sha != expected_sha || metadata.len() != expected_size {
+        return ("TAMPERED", resolved_path, metadata.len(), false);
+    }
+    if provider == "LOYALSOLDIER" && !resolved_path.starts_with("/usr/lib/honk/") {
+        return ("CUSTOM_UNSUPPORTED", resolved_path, metadata.len(), false);
+    }
+    (
+        if provider == "V2FLY" {
+            "V2FLY_LOCKED"
+        } else {
+            "LOYALSOLDIER_LOCKED"
+        },
+        resolved_path,
+        metadata.len(),
+        true,
+    )
+}
+
+fn live_status(site_sha: &str, ip_sha: &str) -> Value {
+    let path = Path::new("/run/honk/geo-live.json");
+    let Ok(raw) = fs::read_to_string(path) else {
+        return json!({"status":"STALE","matching":false,"path":path.display().to_string()});
+    };
+    let Ok(value) = serde_json::from_str::<Value>(&raw) else {
+        return json!({"status":"STALE","matching":false,"path":path.display().to_string()});
+    };
+    let pid = value.get("pid").and_then(Value::as_u64).unwrap_or(0);
+    let alive = pid > 0 && Path::new(&format!("/proc/{pid}")).exists();
+    let matching = alive
+        && value.get("provider").and_then(Value::as_str) == Some("LOYALSOLDIER_LOCKED")
+        && value.get("geositeSha256").and_then(Value::as_str) == Some(site_sha)
+        && value.get("geoipSha256").and_then(Value::as_str) == Some(ip_sha);
+    json!({"status": if matching {"LOYALSOLDIER_LOCKED"} else {"STALE"}, "matching":matching, "receipt":value})
+}
+
+pub fn run(command: GeoCommand) -> Result<()> {
+    match command.command {
+        GeoSubcommand::Capabilities(args) => capabilities(args),
+        GeoSubcommand::Repair(args) => repair(args),
+    }
+}
+
+fn capabilities(args: CapabilityArgs) -> Result<()> {
+    let dir = asset_dir();
+    let site = dir.join("geosite.dat");
+    let ip = dir.join("geoip.dat");
+    let (disk_status, site_resolved, site_size, site_hash_ok) =
+        status_for(&site, LOCK_SITE_SHA, LOCK_SITE_SIZE, "LOYALSOLDIER");
+    let (ip_status, ip_resolved, ip_size, ip_hash_ok) =
+        status_for(&ip, LOCK_IP_SHA, LOCK_IP_SIZE, "V2FLY");
+    let site_sha = sha256(&site).unwrap_or_default();
+    let ip_sha = sha256(&ip).unwrap_or_default();
+    let labels: Vec<Value> = if site_hash_ok {
+        requested_labels(&site, &args.labels)
+    } else {
+        args.labels
+            .iter()
+            .map(|label| json!({"label": label, "present": false}))
+            .collect()
+    };
+    let geoip_labels: Vec<Value> = if ip_hash_ok {
+        requested_labels(&ip, &args.geoip_labels)
+    } else {
+        args.geoip_labels
+            .iter()
+            .map(|label| json!({"label": label, "present": false}))
+            .collect()
+    };
+    let all_labels = labels
+        .iter()
+        .all(|v| v.get("present").and_then(Value::as_bool).unwrap_or(false));
+    let all_geoip = geoip_labels
+        .iter()
+        .all(|v| v.get("present").and_then(Value::as_bool).unwrap_or(false));
+    let combined_disk_status = if disk_status != "LOYALSOLDIER_LOCKED" {
+        disk_status
+    } else if ip_status != "V2FLY_LOCKED" {
+        if ip_status == "V2FLY_GFW_UNSUPPORTED" {
+            "V2FLY_GFW_UNSUPPORTED"
+        } else {
+            "TAMPERED"
+        }
+    } else {
+        "LOYALSOLDIER_LOCKED"
+    };
+    let active = live_status(&site_sha, &ip_sha);
+    let active_status = active
+        .get("status")
+        .and_then(Value::as_str)
+        .unwrap_or("STALE");
+    let ok = (disk_status == "LOYALSOLDIER_LOCKED"
+        && ip_status == "V2FLY_LOCKED"
+        && all_labels
+        && all_geoip)
+        || (args.labels.is_empty() && args.geoip_labels.is_empty());
+    let output = json!({
+        "schemaVersion":"honk.geo.v1",
+        "ok":ok,
+        "diskStatus": combined_disk_status,
+        "activeStatus":active_status,
+        "configuredPath":dir.display().to_string(),
+        "resolvedPaths":{"geosite":site_resolved,"geoip":ip_resolved},
+        "hashes":{"geosite":site_sha,"geoip":ip_sha},
+        "sizes":{"geosite":site_size,"geoip":ip_size},
+        "lockVersion":"202607312254/202607171233",
+        "provider":"LOYALSOLDIER_LOCKED",
+        "providers":{"geosite":disk_status,"geoip":ip_status},
+        "labels":labels,
+        "geoipLabels":geoip_labels,
+        "live":active
+    });
+    if args.json {
+        println!("{}", serde_json::to_string(&output)?);
+    } else {
+        println!("{}", serde_json::to_string_pretty(&output)?);
+    }
+    if ok {
+        Ok(())
+    } else {
+        Err(anyhow::anyhow!("geo capability check failed"))
+    }
+}
+
+fn repair(args: RepairArgs) -> Result<()> {
+    if !args.confirm {
+        anyhow::bail!("repair requires --confirm")
+    }
+    if unsafe { libc::geteuid() } != 0 {
+        anyhow::bail!("repair requires root")
+    }
+    let payload = Path::new("/usr/lib/honk/geosite.dat");
+    if !payload.is_file()
+        || fs::metadata(payload)?.len() != LOCK_SITE_SIZE
+        || sha256(payload)? != LOCK_SITE_SHA
+    {
+        anyhow::bail!("locked Honk geosite payload is missing or tampered")
+    }
+    let link = Path::new("/usr/share/honk/geosite.dat");
+    fs::create_dir_all(link.parent().context("geosite directory")?)?;
+    let temp = link.with_extension(format!("repair.{}", std::process::id()));
+    let _ = fs::remove_file(&temp);
+    std::os::unix::fs::symlink(payload, &temp)?;
+    fs::rename(&temp, link)?;
+    if let Some(parent) = link.parent()
+        && let Ok(dir) = fs::File::open(parent) {
+        let _ = dir.sync_all();
+    }
+    let output = json!({"ok":true,"repaired":true,"path":link.display().to_string(),"resolvedPath":resolved(link),"diskStatus":"LOYALSOLDIER_LOCKED","activeStatus":"STALE","needsRestart":true});
+    if args.json {
+        println!("{}", serde_json::to_string(&output)?);
+    } else {
+        println!("geosite symlink repaired; restart Honk to activate")
+    }
+    Ok(())
+}
+
+struct ProtoDecoder<'a> {
+    data: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> ProtoDecoder<'a> {
+    fn new(data: &'a [u8]) -> Self {
+        Self { data, pos: 0 }
+    }
+
+    fn is_empty(&self) -> bool {
+        self.pos >= self.data.len()
+    }
+
+    fn read_byte(&mut self) -> io::Result<u8> {
+        if self.pos >= self.data.len() {
+            return Err(io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                "unexpected end of protobuf data",
+            ));
+        }
+        let byte = self.data[self.pos];
+        self.pos += 1;
+        Ok(byte)
+    }
+
+    fn read_varint(&mut self) -> io::Result<u64> {
+        let mut value = 0u64;
+        let mut shift = 0;
+        loop {
+            let byte = self.read_byte()?;
+            value |= u64::from(byte & 0x7f) << shift;
+            if byte & 0x80 == 0 {
+                return Ok(value);
+            }
+            shift += 7;
+            if shift > 63 {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "protobuf varint overflow",
+                ));
+            }
+        }
+    }
+
+    fn read_tag(&mut self) -> io::Result<(u32, u8)> {
+        let tag = self.read_varint()?;
+        Ok(((tag >> 3) as u32, (tag & 0x7) as u8))
+    }
+
+    fn read_len_delimited(&mut self) -> io::Result<&'a [u8]> {
+        let len = self.read_varint()? as usize;
+        let end = self.pos.checked_add(len).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::InvalidData, "protobuf length overflow")
+        })?;
+        if end > self.data.len() {
+            return Err(io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                "protobuf field exceeds payload",
+            ));
+        }
+        let value = &self.data[self.pos..end];
+        self.pos = end;
+        Ok(value)
+    }
+
+    fn skip_field(&mut self, wire: u8) -> io::Result<()> {
+        match wire {
+            0 => {
+                self.read_varint()?;
+            }
+            1 => {
+                let end = self.pos.checked_add(8).ok_or_else(|| {
+                    io::Error::new(io::ErrorKind::InvalidData, "protobuf length overflow")
+                })?;
+                if end > self.data.len() {
+                    return Err(io::Error::new(
+                        io::ErrorKind::UnexpectedEof,
+                        "protobuf field exceeds payload",
+                    ));
+                }
+                self.pos = end;
+            }
+            2 => {
+                self.read_len_delimited()?;
+            }
+            5 => {
+                let end = self.pos.checked_add(4).ok_or_else(|| {
+                    io::Error::new(io::ErrorKind::InvalidData, "protobuf length overflow")
+                })?;
+                if end > self.data.len() {
+                    return Err(io::Error::new(
+                        io::ErrorKind::UnexpectedEof,
+                        "protobuf field exceeds payload",
+                    ));
+                }
+                self.pos = end;
+            }
+            _ => {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    format!("unsupported protobuf wire type {wire}"),
+                ));
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::has_code_bytes;
+
+    #[test]
+    fn decodes_top_level_geo_code_without_substring_matching() {
+        let data = [0x0a, 0x05, 0x0a, 0x03, b'g', b'f', b'w'];
+        assert!(has_code_bytes(&data, "gfw").unwrap());
+        assert!(!has_code_bytes(&data, "fw").unwrap());
+    }
+
+    #[test]
+    fn malformed_dat_is_rejected() {
+        assert!(has_code_bytes(&[0x0a, 0x05, 0x0a], "gfw").is_err());
+    }
+}
