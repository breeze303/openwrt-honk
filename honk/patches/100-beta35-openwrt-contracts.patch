+/// Remove Xray's `ed=` early-data marker from Clash WebSocket paths.
+/// Honk sends the VLESS header as the first binary WebSocket frame, which is
+/// accepted by the same providers without relying on the subprotocol variant.
+fn strip_ws_early_data(path: &str) -> String {
+    let Some((base, params)) = path.split_once('?') else {
+        return path.to_string();
+    };
+    let kept: Vec<&str> = params
+        .split('&')
+        .filter(|part| !part.starts_with("ed="))
+        .collect();
+    if kept.is_empty() {
+        base.to_string()
+    } else {
+        format!("{base}?{}", kept.join("&"))
+    }
+}
