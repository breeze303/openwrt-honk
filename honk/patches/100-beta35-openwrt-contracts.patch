+async fn get_subscriptions(State(s): State<Arc<ClashState>>) -> Json<serde_json::Value> {
+    let config = s.config.read().await;
+    let subscriptions = config
+        .subscriptions
+        .iter()
+        .map(|subscription| {
+            let nodes = config
+                .nodes
+                .iter()
+                .filter(|node| node.subscription_id == Some(subscription.id))
+                .map(|node| {
+                    serde_json::json!({
+                        "name": node.name,
+                        "protocol": node.protocol.as_str(),
+                    })
+                })
+                .collect::<Vec<_>>();
+            let state = if subscription.last_error.is_some() {
+                "error"
+            } else if subscription.node_count > 0 {
+                "ready"
+            } else {
+                "idle"
+            };
+            serde_json::json!({
+                "name": subscription.name,
+                "enabled": subscription.enabled,
+                "updateInterval": subscription.update_interval,
+                "nodeCount": subscription.node_count,
+                "updatedAt": subscription.last_updated.map(|time| time.to_rfc3339()),
+                "state": state,
+                "error": subscription.last_error,
+                "nodes": nodes,
+            })
+        })
+        .collect::<Vec<_>>();
+    Json(serde_json::json!({"subscriptions": subscriptions}))
+}
+
+async fn refresh_subscription(
+    State(s): State<Arc<ClashState>>,
+    Path(name): Path<String>,
+) -> Response {
+    let subscription = {
+        let config = s.config.read().await;
+        config
+            .subscriptions
+            .iter()
+            .find(|subscription| subscription.name == name)
+            .cloned()
+    };
+    let Some(subscription) = subscription else {
+        return error_response(StatusCode::NOT_FOUND, "subscription not found");
+    };
+    let command_tx = s.command_tx.clone();
+    tokio::spawn(async move {
+        let result = match crate::subscription::SubscriptionManager::new() {
+            Ok(manager) => manager.fetch(&subscription).await,
+            Err(error) => Err(error),
+        };
+        match result {
+            Ok(nodes) => {
+                let _ = command_tx
+                    .send(crate::control::ControlCommand::MergeSubscription {
+                        subscription_id: subscription.id,
+                        name: subscription.name,
+                        nodes,
+                    })
+                    .await;
+            }
+            Err(error) => {
+                let _ = command_tx
+                    .send(crate::control::ControlCommand::SubscriptionError {
+                        subscription_id: subscription.id,
+                        name: subscription.name,
+                        error: error.to_string().replace(&subscription.url, "<subscription>"),
+                    })
+                    .await;
+            }
+        }
+    });
+    StatusCode::ACCEPTED.into_response()
+}
